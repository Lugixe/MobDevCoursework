<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/citySelectionFragment">

    <fragment
        android:id="@+id/citySelectionFragment"
        android:name="ru.mobile.mobdevweatherforecast.ui.city.CitySelectionFragment"
        tools:layout="@layout/fragment_city_selection">

        <action
            android:id="@+id/action_citySelection_to_weather"
            app:destination="@id/weatherFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="ru.mobile.mobdevweatherforecast.ui.weather.WeatherFragment"
        tools:layout="@layout/fragment_weather">

        <argument android:name="cities_ui" app:argType="string[]" />
        <argument android:name="cities_api" app:argType="string[]" />
    </fragment>

</navigation>